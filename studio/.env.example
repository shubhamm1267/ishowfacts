# Copy to .env. Never place your real keys inside Angular or commit this file.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
# Public voice IDs; you can swap these for other native male voices from Cartesia's catalog.
CARTESIA_VOICE_HI_MALE_ID=6303e5fb-a0a7-48f9-bb1a-dd42c216dc5d
CARTESIA_VOICE_HI_ANUJ_ID=7e8cb11d-37af-476b-ab8f-25da99b18644
CARTESIA_VOICE_HI_AYUSH_ID=791d5162-d5eb-40f0-8189-f19db44611d8
CARTESIA_VOICE_HI_RAKESH_ID=6b7468f5-d6b0-4d6b-b38a-46f6d6e5bac7
NARRATOR_HINDI_PITCH=1.14
NARRATOR_PITCH_ANUJ=1.18
NARRATOR_PITCH_AYUSH=1.19
NARRATOR_PITCH_RAKESH=1.11
CARTESIA_VOICE_EN_US_MALE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1
CARTESIA_VOICE_EN_GB_MALE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
FREESOUND_API_KEY=
# Free licensed stock clips. Secrets stay on the backend.
VECTEEZY_ACCOUNT_ID=
VECTEEZY_API_KEY=
ENABLE_STOCK_VIDEO=1
# Original paper layout cap only; reference mixed mode uses the duration budget.
STOCK_VIDEO_MAX_SCENES=3
STOCK_VIDEO_CANDIDATES=2
STOCK_VIDEO_MAX_MB=80
HOST=127.0.0.1
PORT=4300
FRONTEND_ORIGIN=http://localhost:4200
# Set 1 to allow clearly labelled offline demo renders without provider keys.
DEMO_MODE=0
# Set 1 and install rembg for true isolated PNG subject cutouts.
ENABLE_REMBG=0
REMBG_MODEL=isnet-general-use
CUTOUT_ALPHA_MATTING=0
GEMINI_CUTOUT_QA=1
STRICT_IMAGE_QA=1
IMAGE_CANDIDATES=6
# Reference videos stay full-resolution at 24 fps; tune encoder speed separately.
RENDER_FPS=24
PAPERDOC_PRESET=veryfast
PAPERDOC_CRF=17
GEMINI_IMAGE_QA=1
SKIP_CONTACT_SHEET=0

# Voice provider: fish (default in UI), heygen or cartesia
VOICE_PROVIDER=fish
FISH_API_KEY=
# Explicit free model only; no paid or provider fallback. Promotional availability may change.
FISH_MODEL=s2.1-pro-free
FISH_VOICE_ID=7b9a4ac6ec9849fd8a3290671f024515
HEYGEN_API_KEY=
HEYGEN_MODEL=heygen-voice-1-turbo-free
HEYGEN_VOICE_HI_ID=GjEYDLj9QcrWiwxXmBbE
HEYGEN_SPEECH_API=turbo-free
# Catalog speech may consume credits; set 1 to use it. No paid/free fallback.
HEYGEN_ALLOW_CATALOG=0
HEYGEN_VOICE_EN_ID=
# Local formant-preserving processing; energetic Hindi only, before shot timing.
HEYGEN_PITCH_SEMITONES=3
HEYGEN_TEMPO=1.08

# Optional licensed video fallbacks
PEXELS_API_KEY=
COVERR_API_KEY=

# Fish voice for English only; Hindi retains its current voice.
FISH_VOICE_EN_ID=0f63dce1a01b4991b56940c0e6a1464f
