# Copy to .env. Never place your real keys inside Angular or commit this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
# Public voice IDs; you can swap these for other native male voices from Cartesia's catalog.
CARTESIA_VOICE_HI_MALE_ID=6303e5fb-a0a7-48f9-bb1a-dd42c216dc5d
CARTESIA_VOICE_HI_ANUJ_ID=7e8cb11d-37af-476b-ab8f-25da99b18644
CARTESIA_VOICE_HI_AYUSH_ID=791d5162-d5eb-40f0-8189-f19db44611d8
CARTESIA_VOICE_HI_RAKESH_ID=6b7468f5-d6b0-4d6b-b38a-46f6d6e5bac7
NARRATOR_HINDI_PITCH=1.14
NARRATOR_PITCH_ANUJ=1.18
NARRATOR_PITCH_AYUSH=1.19
NARRATOR_PITCH_RAKESH=1.11
CARTESIA_VOICE_EN_US_MALE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1
CARTESIA_VOICE_EN_GB_MALE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
FREESOUND_API_KEY=
HOST=127.0.0.1
PORT=4300
FRONTEND_ORIGIN=http://localhost:4200
# Set 1 to allow clearly labelled offline demo renders without provider keys.
DEMO_MODE=0
# Set 1 and install rembg for true isolated PNG subject cutouts.
ENABLE_REMBG=0
REMBG_MODEL=isnet-general-use
CUTOUT_ALPHA_MATTING=0
GEMINI_CUTOUT_QA=1
STRICT_IMAGE_QA=1
IMAGE_CANDIDATES=6
# For test runs only, override FPS to reduce rendering time. Production default: 30.
RENDER_FPS=30
GEMINI_IMAGE_QA=1
SKIP_CONTACT_SHEET=0
